# Plaid API keys from https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=...
PLAID_SECRET=...
# sandbox (free, fake banks) or production (real accounts; needs Plaid approval)
PLAID_ENV=sandbox

# Optional. Defaults are data/, secrets/ and audit/ inside the repo.
# LEDGERLINE_DATA_DIR=
# LEDGERLINE_SECRETS_DIR=
# LEDGERLINE_AUDIT_DIR=

# Optional. Hostnames the web app answers to (comma-separated).
# LEDGERLINE_ALLOWED_HOSTS=localhost,127.0.0.1
